# TableRelay — backend environment
# Copy to .env and fill in the PocketBase superuser you create in step 3
# of the Quick Start (README.md). Never commit .env.

# Port the Express + Socket.io server listens on
PORT=3000

# Origin allowed to talk to the backend (the Vite dev server)
CONTROL_PANEL_ORIGIN=http://localhost:5173

# PocketBase instance
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser credentials.
# Created on first run at http://127.0.0.1:8090/_/ — see README Quick Start.
PB_MAIL=admin@example.com
PB_PASS=change-me-at-least-10-chars

# ── Optional: only needed for auxiliary scripts, not to run the app ──
# GITHUB_PAT=
# NOTION_API_KEY=
# CONTEXT7_API_KEY=
